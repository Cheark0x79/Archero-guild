# Copy to .env.production on the homelab server. Never commit the real file.
ARCHERO_DASHBOARD_PORT=5181
ARCHERO_BIND_ADDRESS=127.0.0.1
ARCHERO_PUBLIC_ORIGIN=https://archero.example.com
POSTGRES_DB=archero_observer
POSTGRES_USER=archero
POSTGRES_PASSWORD=generate-a-long-random-database-password
ARCHERO_USER_USERNAME=viewer
ARCHERO_USER_PASSWORD=generate-a-long-user-password
ARCHERO_USER_SESSION_TOKEN=generate-at-least-32-random-bytes
ARCHERO_ADMIN_USERNAME=admin
ARCHERO_ADMIN_PASSWORD=generate-a-different-long-admin-password
ARCHERO_ADMIN_SESSION_TOKEN=generate-at-least-32-random-bytes
ARCHERO_API_KEYS=generate-a-long-random-discord-api-key
ARCHERO_INGESTION_KEYS=generate-a-different-key-used-only-by-the-local-ocr-agent
CLOUDFLARE_TUNNEL_TOKEN=paste-the-token-from-cloudflare-zero-trust
