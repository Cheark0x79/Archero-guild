# Generic production configuration.
# Copy to web/.env.prod, replace every secret independently, and
# restrict the real file to the operator account.

# Optional network settings with safe loopback defaults.
ARCHERO_DASHBOARD_PORT=5181
ARCHERO_BIND_ADDRESS=127.0.0.1

# Published Web/API image. Mirror or override it only deliberately.
ARCHERO_WEB_IMAGE=ghcr.io/cheark0x79/archero-guild-web
# Pin the published release. Change deliberately during a release upgrade.
ARCHERO_IMAGE_TAG=0.2.2

# Required public value. Exact HTTPS origin without a path.
ARCHERO_PUBLIC_ORIGIN=https://archero.example.com

# Optional performance and abuse-protection defaults.
ARCHERO_DATA_CACHE_TTL_MS=15000
ARCHERO_DATA_ERROR_CACHE_TTL_MS=2000
ARCHERO_API_RATE_LIMIT_PER_MINUTE=120

# PostgreSQL. Password is a required dedicated secret.
POSTGRES_DB=archero_observer
POSTGRES_USER=archero
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Standard dashboard account. Password and session token are distinct secrets.
ARCHERO_USER_USERNAME=viewer
ARCHERO_USER_PASSWORD=replace-with-a-long-random-user-password
ARCHERO_USER_SESSION_TOKEN=replace-with-at-least-32-random-bytes

# Administrator account. Never reuse standard-user credentials.
ARCHERO_ADMIN_USERNAME=admin
ARCHERO_ADMIN_PASSWORD=replace-with-a-different-random-admin-password
ARCHERO_ADMIN_SESSION_TOKEN=replace-with-at-least-32-different-random-bytes

# Dedicated integration secrets. Generate a different value for each purpose.
ARCHERO_API_KEYS=replace-with-a-long-random-discord-api-key
ARCHERO_SHARE_LINK_SECRET=replace-with-at-least-32-random-bytes-for-share-links
ARCHERO_INGESTION_KEYS=replace-with-a-different-random-ocr-ingestion-key
