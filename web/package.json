  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 5181",
    "prebuild": "npm run openapi:sync",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 5181",
    "test": "node --test tests/*.test.mjs",
