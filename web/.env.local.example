# Native Next.js development. Copy to web/.env.local.

# Required public value. Exact browser-facing origin without a path.
ARCHERO_PUBLIC_ORIGIN=http://127.0.0.1:5181
ARCHERO_DEPLOYMENT_ENV=development

# Required local administrator credentials.
ARCHERO_ADMIN_USERNAME=admin
ARCHERO_ADMIN_PASSWORD=replace-with-a-local-admin-password
ARCHERO_ADMIN_SESSION_TOKEN=replace-with-a-random-local-admin-session-token

# Optional standard user account. Set password and token together.
ARCHERO_USER_USERNAME=viewer
# ARCHERO_USER_PASSWORD=replace-with-a-local-user-password
# ARCHERO_USER_SESSION_TOKEN=replace-with-a-random-local-user-session-token

# Required for temporary member links. Use at least 32 random bytes.
ARCHERO_SHARE_LINK_SECRET=replace-with-at-least-32-random-bytes

# Optional locally. Production requires at least one API key.
# ARCHERO_API_KEYS=replace-with-a-local-api-key

# Required only when exercising the remote ingestion API locally.
# ARCHERO_INGESTION_KEYS=replace-with-a-dedicated-local-ingestion-key

# Optional performance and abuse-protection defaults.
ARCHERO_DATA_CACHE_TTL_MS=15000
ARCHERO_DATA_ERROR_CACHE_TTL_MS=2000
ARCHERO_API_RATE_LIMIT_PER_MINUTE=120

# Synthetic Web fixtures. Explicit demo mode is accepted only on loopback and
# is always refused when ARCHERO_REQUIRE_DATABASE=1.
ARCHERO_DATA_MODE=demo
ARCHERO_DEMO_SEED=archero-web-demo-v1
ARCHERO_DEMO_ANCHOR_DATE=2026-08-09
ARCHERO_DEMO_SCENARIO=baseline

# Admin-only PostgreSQL seeding for a dedicated isolated test environment.
# Requires development/test mode, a loopback origin, non-strict database mode,
# and a dedicated database.
# ARCHERO_ENVIRONMENT_ID=t-local-web
# ARCHERO_ENABLE_TEST_DATA_ADMIN=1

# Uncomment for PostgreSQL mode. Leave both URLs unset for demo mode.
# ARCHERO_DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer
# DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer
