# Local PostgreSQL and Python tools only.
# Copy to .env when running imports, migrations, or exports from the shell.

# Optional. Default: 55440. Loopback port for the development database.
ARCHERO_POSTGRES_PORT=55440

# Conditional. Preferred PostgreSQL DSN when database-backed tools are used.
ARCHERO_DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer

# Conditional alias. ARCHERO_DATABASE_URL takes precedence when both exist.
# DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer

# Emergency override only. Leave unset during normal imports.
# ARCHERO_ALLOW_PARTIAL_REPLACEMENT=1
