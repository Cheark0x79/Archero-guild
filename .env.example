# PostgreSQL connection used by the Python import/migration tools.
# Keep this file as an example only; put real secrets in .env or your shell.
ARCHERO_POSTGRES_PORT=55440
ARCHERO_DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer

# DATABASE_URL is also supported. ARCHERO_DATABASE_URL has priority when both exist.
# DATABASE_URL=postgresql://archero:archero_dev_password@127.0.0.1:55440/archero_observer
ARCHERO_USER_USERNAME=viewer
ARCHERO_USER_PASSWORD=replace-with-a-long-user-password
ARCHERO_USER_SESSION_TOKEN=replace-with-a-random-user-session-token
ARCHERO_ADMIN_USERNAME=admin
ARCHERO_ADMIN_PASSWORD=replace-with-a-long-admin-password
ARCHERO_ADMIN_SESSION_TOKEN=replace-with-a-random-session-token

# Comma-separated API keys accepted by /api/v1 (except /api/v1/health).
# If omitted, authentication is disabled for local development.
# ARCHERO_API_KEYS=replace-with-a-long-random-secret

# Public API performance and abuse protection.
ARCHERO_DATA_CACHE_TTL_MS=15000
ARCHERO_DATA_ERROR_CACHE_TTL_MS=2000
ARCHERO_API_RATE_LIMIT_PER_MINUTE=120
