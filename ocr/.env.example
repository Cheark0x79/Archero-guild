# Local OCR workstation. Copy to ocr/.env.

# Optional runtime identity and loopback UI port.
ARCHERO_AGENT_VERSION=development
ARCHERO_OCR_UI_PORT=5190

# Published OCR image. Source development may still use Compose --build.
ARCHERO_OCR_IMAGE=ghcr.io/cheark0x79/archero-guild-ocr
# Pin the published release. Change deliberately during a workstation update.
ARCHERO_OCR_IMAGE_TAG=0.2.1

# Host paths mounted into the OCR container.
ARCHERO_CAPTURE_ROOT=../screenshots/raw
ARCHERO_OUTBOX_ROOT=../data/outbox
ARCHERO_OCR_TARGETS_FILE=./targets.json
