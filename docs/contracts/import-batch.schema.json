{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archero-guild.example/contracts/import-batch.schema.json",
  "title": "Archero OCR import batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "captureDate",
    "generatedAt",
    "agentVersion",
    "idempotencyKey",
    "sourceImages",
    "members",
    "bossRankings",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "captureDate": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotencyKey": { "type": "string", "minLength": 16, "maxLength": 200 },
    "sourceImages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256", "width", "height", "detectedRows"],
        "properties": {
          "kind": { "enum": ["guild-members", "guild-boss"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "width": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "height": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "detectedRows": { "type": "integer", "minimum": 0, "maximum": 100 },
          "sourceName": { "type": "string", "maxLength": 255 }
        }
      }
    },
    "members": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "source"],
        "properties": {
          "playerId": { "type": ["string", "null"], "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "role": { "type": ["string", "null"] },
          "power": { "type": ["integer", "null"], "minimum": 0 },
          "contribution7d": { "type": ["integer", "null"], "minimum": 0 },
          "bossAttacks": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
          "lastActivityDays": { "type": ["integer", "null"], "minimum": 0 },
          "activityText": { "type": ["string", "null"], "maxLength": 32 },
          "rawActivity": { "type": ["string", "null"], "maxLength": 128 },
          "source": { "type": "string", "minLength": 1, "maxLength": 255 },
          "rawName": { "type": ["string", "null"], "maxLength": 255 },
          "matchScore": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "bossRankings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "rank", "damageText", "damage", "source"],
        "properties": {
          "playerId": { "type": ["string", "null"], "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "rawName": { "type": ["string", "null"], "maxLength": 255 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
          "damageText": { "type": "string", "minLength": 1, "maxLength": 32 },
          "damage": { "type": "integer", "minimum": 0 },
          "area": { "enum": ["podium", "list"] },
          "rowIndex": { "type": "integer", "minimum": 0 },
          "source": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      }
    },
    "guildStats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "guildName": { "type": ["string", "null"], "maxLength": 128 },
        "guildId": { "type": ["string", "null"], "maxLength": 128 },
        "level": { "type": ["integer", "null"], "minimum": 0 },
        "memberCount": { "type": ["integer", "null"], "minimum": 0 },
        "memberCapacity": { "type": ["integer", "null"], "minimum": 0 },
        "totalPower": { "type": ["integer", "null"], "minimum": 0 },
        "expeditionPoints": { "type": ["integer", "null"], "minimum": 0 },
        "expeditionName": { "type": ["string", "null"], "maxLength": 128 },
        "expeditionRank": { "type": ["string", "null"], "maxLength": 128 },
        "xpCurrent": { "type": ["integer", "null"], "minimum": 0 },
        "xpRequired": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "coverage", "completeness", "warnings"],
      "properties": {
        "status": { "enum": ["pass", "review", "failed"] },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
